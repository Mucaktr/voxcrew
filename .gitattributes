# Satır sonları depoda LF; Windows betikleri CRLF ile çıkar.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf

# İkili dosyalar (fark ve satır sonu dönüşümü yok)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.glb   binary
*.db    binary
*.sqlite binary
*.zip   binary

# Kilit dosyaları: GitHub farkında daralt
backend/uv.lock             linguist-generated=true -diff
frontend/package-lock.json  linguist-generated=true -diff
